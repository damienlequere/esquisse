{
  "name": "esquisse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@esquisse/web",
    "dev:mobile": "pnpm --filter @esquisse/mobile start",
    "dev:all": "turbo run dev",
    "generate-game": "pnpm --filter @esquisse/generator generate-game",
    "generate-scene": "pnpm --filter @esquisse/generator generate-scene",
    "link-game": "pnpm --filter @esquisse/generator link-game",
    "generate-night": "pnpm --filter @esquisse/generator generate-night",
    "remove-scene": "pnpm --filter @esquisse/generator remove-scene",
    "remove-game": "pnpm --filter @esquisse/generator remove-game",
    "show-scene": "pnpm --filter @esquisse/generator show-scene",
    "check-game": "pnpm --filter @esquisse/generator check-game",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy:preview": "pnpm lint && pnpm typecheck && pnpm check-game && vercel deploy",
    "deploy:prod": "pnpm lint && pnpm typecheck && pnpm check-game && vercel deploy --prod",
    "mobile:login": "pnpm --filter @esquisse/mobile eas:login",
    "mobile:whoami": "pnpm --filter @esquisse/mobile eas:whoami",
    "mobile:apk": "pnpm --filter @esquisse/mobile build:apk",
    "mobile:ios": "pnpm --filter @esquisse/mobile build:ios",
    "mobile:builds": "pnpm --filter @esquisse/mobile builds",
    "mobile:update": "pnpm lint && pnpm typecheck && pnpm check-game && pnpm --filter @esquisse/mobile update:preview",
    "mobile:updates": "pnpm --filter @esquisse/mobile updates",
    "mobile:device": "pnpm --filter @esquisse/mobile device:add",
    "mobile:doctor": "pnpm --filter @esquisse/mobile expo:doctor",
    "eas": "pnpm --filter @esquisse/mobile eas",
    "loc": "node scripts/loc.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@template/web",
    "dev:mobile": "pnpm --filter @template/mobile start",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy:preview": "pnpm lint && pnpm typecheck && vercel deploy",
    "deploy:prod": "pnpm lint && pnpm typecheck && vercel deploy --prod",
    "loc": "node scripts/loc.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}

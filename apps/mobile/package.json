{
  "name": "@esquisse/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "expo:doctor": "npx expo-doctor",
    "eas": "npx eas-cli@latest",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "build:apk": "npx eas-cli@latest build --profile preview --platform android",
    "build:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "builds": "npx eas-cli@latest build:list --limit 5",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --auto",
    "updates": "npx eas-cli@latest update:list --branch preview --limit 5",
    "device:add": "npx eas-cli@latest device:create"
  },
  "dependencies": {
    "@esquisse/content": "workspace:*",
    "@esquisse/engine": "workspace:*",
    "@expo/metro-runtime": "~58.0.15",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.22",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}

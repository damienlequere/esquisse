{
  "expo": {
    "name": "Esquisse",
    "slug": "esquisse",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.damienlequere.esquisse"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-status-bar"],
    "scheme": "esquisse",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8b1cdd6b-d0f9-4974-aee5-92a98247e09b"
      }
    },
    "owner": "damienlequere",
    "updates": {
      "url": "https://u.expo.dev/8b1cdd6b-d0f9-4974-aee5-92a98247e09b"
    }
  }
}
